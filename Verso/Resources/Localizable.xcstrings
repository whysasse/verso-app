    },
    "onboarding.theme.subheadline": {
      "extractionState": "manual",
      "comment": "Subheadline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this any time from settings."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu peux le modifier à tout moment dans les réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode alterar isso a qualquer momento nas configurações."
          }
        }
      }
    },
