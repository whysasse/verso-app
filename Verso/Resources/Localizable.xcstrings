    "onboarding.analyticsConsent.subheadline": {
      "extractionState": "manual",
      "comment": "Subheadline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share anonymous usage data — no personal info, no article content, ever."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Partage des données d'utilisation anonymes — aucune information personnelle, aucun contenu d'article, jamais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compartilhe dados de uso anônimos — sem informações pessoais, sem conteúdo de artigos, nunca."
          }
        }
      }
    },
