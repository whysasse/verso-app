    "onboarding.folder.headline": {
      "extractionState": "manual",
      "comment": "Corrected \"store\" → \"save\" during step 4 view-wiring pass to match shipped code — fr-CA/pt-BR already said \"save\" (enregistrer/guardar), so en was the stale one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where should Verso save your articles?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où Verso doit-il enregistrer tes articles?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde o Verso deve guardar seus artigos?"
          }
        }
      }
    },
    "onboarding.folder.subheadline": {
      "extractionState": "manual",
      "comment": "Code previously had different wording (\"Articles are saved as Markdown files — yours to keep.\"); switched to this canonical copy during step 4 view-wiring pass since fr-CA/pt-BR were already translated against it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a folder in iCloud Drive. Verso saves each article as a Markdown file you can open anywhere."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisis un dossier dans iCloud Drive. Verso enregistre chaque article comme un fichier Markdown que tu peux ouvrir n'importe où."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma pasta no iCloud Drive. O Verso salva cada artigo como um arquivo Markdown que você pode abrir em qualquer lugar."
          }
        }
      }
    },
    "onboarding.folder.chooseCta": {
      "extractionState": "manual",
      "comment": "Added ellipsis during step 4 view-wiring pass to match the row-placeholder treatment shipped in code (not a standalone button as the original \"Primary button\" location implied).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose folder…"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisir un dossier…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolher pasta…"
          }
        }
      }
    },
    "onboarding.folder.continueCta": {
      "extractionState": "manual",
      "comment": "Added during step 4 view-wiring pass — missed in the original audit.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continuar"
          }
        }
      }
    },
    "onboarding.folder.privacyNote": {
      "extractionState": "manual",
      "comment": "Added during step 4 view-wiring pass — missed in the original audit.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verso never uploads your files. They live in your iCloud Drive."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verso ne téléverse jamais tes fichiers. Ils restent dans ton iCloud Drive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Verso nunca envia seus arquivos para a nuvem. Eles ficam no seu iCloud Drive."
          }
        }
      }
    },
    "onboarding.folder.obsidianTip": {
      "extractionState": "manual",
      "comment": "Documented but not yet shown in `OnboardingFolderPickerView.swift` — adding it is a UI change, not just a wiring fix. Tracked as FAB-280, see docs/BACKLOG.md.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using Obsidian? Point Verso to a folder inside your vault and articles will appear there automatically."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu utilises Obsidian? Pointe Verso vers un dossier dans ton coffre et les articles y apparaîtront automatiquement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa o Obsidian? Aponte o Verso para uma pasta dentro do seu vault e os artigos vão aparecer lá automaticamente."
          }
        }
      }
    },
    "onboarding.tour.headline": {
      "extractionState": "manual",
      "comment": "Headline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's how it works"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voici comment ça fonctionne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veja como funciona"
          }
        }
      }
    },
    "onboarding.tour.step1": {
      "extractionState": "manual",
      "comment": "Step 1 label",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share any article from Safari or your browser to save it instantly."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Partage n'importe quel article depuis Safari ou ton navigateur pour l'enregistrer instantanément."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compartilhe qualquer artigo do Safari ou do seu navegador para salvá-lo instantaneamente."
          }
        }
      }
    },
    "onboarding.tour.step2": {
      "extractionState": "manual",
      "comment": "Step 2 label",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Verso to read. Your list is always in sync with your files."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvre Verso pour lire. Ta liste est toujours synchronisée avec tes fichiers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o Verso para ler. Sua lista está sempre sincronizada com seus arquivos."
          }
        }
      }
    },
    "onboarding.tour.step3": {
      "extractionState": "manual",
      "comment": "Step 3 label",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark articles as read when you're done. They stay in your folder forever."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marque les articles comme lus une fois terminés. Ils restent dans ton dossier pour toujours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marque os artigos como lidos quando terminar. Eles permanecem na sua pasta para sempre."
          }
        }
      }
    },
    "onboarding.tour.skip": {
      "extractionState": "manual",
