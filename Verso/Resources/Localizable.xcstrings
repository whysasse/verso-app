{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.welcome.headline": {
      "extractionState": "manual",
      "comment": "Headline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your articles. Your files."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tes articles. Tes fichiers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seus artigos. Seus arquivos."
          }
        }
      }
    },
    "onboarding.welcome.subheadline": {
      "extractionState": "manual",
      "comment": "Subheadline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet place to read. No accounts, no algorithms — just Markdown files in your iCloud Drive."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un endroit calme pour lire. Aucun compte, aucun algorithme — seulement des fichiers Markdown dans ton iCloud Drive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um lugar tranquilo para ler. Sem contas, sem algoritmos — apenas arquivos Markdown no seu iCloud Drive."
          }
        }
      }
    },
    "onboarding.welcome.cta": {
      "extractionState": "manual",
      "comment": "Primary button",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commencer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Começar"
          }
        }
      }
    },
    "onboarding.theme.headline": {
      "extractionState": "manual",
      "comment": "Headline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your reading theme"
          }
        },
        "fr-CA": {
          "stringUnit": {
